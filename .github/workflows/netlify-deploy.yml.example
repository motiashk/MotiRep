# Example GitHub Actions workflow for Netlify deployment
# This workflow demonstrates how to integrate GitHub Actions with Netlify
# Note: Netlify has built-in Git integration, so this is optional

name: Deploy to Netlify

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Run tests (optional)
        run: npm test
        continue-on-error: true

      - name: Build project
        run: npm run build
        env:
          # Add your build-time environment variables here
          # REACT_APP_API_URL: ${{ secrets.REACT_APP_API_URL }}
          NODE_ENV: production

      - name: Deploy to Netlify
        uses: netlify/actions/cli@master
        env:
          NETLIFY_AUTH_TOKEN: ${{ secrets.NETLIFY_AUTH_TOKEN }}
          NETLIFY_SITE_ID: ${{ secrets.NETLIFY_SITE_ID }}
        with:
          args: deploy --dir=dist --prod
          
      - name: Notify deployment status
        if: success()
        run: echo "Deployment successful!"
